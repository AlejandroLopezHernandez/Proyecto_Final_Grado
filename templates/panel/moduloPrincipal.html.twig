{% extends 'base.html.twig' %}

{% block title %}TPV Restaurante{% endblock %}


{% block body %}
<div class="layout">
    <nav class="NavegadorPrincipal">
        <div>
    <h1 style="text-align: center;">Terminal De Ventas</h1>
</div>        
    </nav>

    <div id="contenido-dinamico">        
            <div class="contenedor-mapa" id="fondoMapa">
                {# Aquí se cargarán las mesas dinámicamente por JS #}
            </div>

            <nav class="navegadorLateral">           
                <button id="btnVerMapaMesas" class="editor-btn">Plano de Mesas</button>
                <button onclick="window.location.href='{{ path('editar_mapa_mesas') }}'"  class="editor-btn">Editar Mapa De Mesas</button>            
                <button onclick="window.location.href='{{ path('ver_reservas') }}'"  id="btnVerReservas" class="editor-btn">Ver reservas</button>
                <button onclick="window.open('{{ path('carta_cliente') }}', '_blank')"  class="editor-btn" >Ver Carta Cliente</button>
                <button onclick="window.open('{{ path('ver_carta') }}', '_blank')"  class="editor-btn" >Ver Carta Camarero</button>
                <button onclick="window.open('/comanda/ver', '_blank')" class="editor-btn">Ver Historial de Tickets</button>   
            </nav>        
    </div> 
</div>



{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/moduloPrincipal.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script defer src="{{ asset('js/moduloPrincipal.js') }}"></script>
{% endblock %}