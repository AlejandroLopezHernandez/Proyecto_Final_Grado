{% extends 'base.html.twig' %}

{% block title %}Dashboard de manager{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .dashboard-container {
            display: grid;
            gap: 20px;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            padding: 20px;
        }

        .chart-card {
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 15px;
            transition: transform 0.3s ease;
        }

        .chart-card:hover {
            transform: translateY(-5px);
        }

        .chart-title {
            font-size: 1.1rem;
            margin-bottom: 15px;
            color: #333;
            text-align: center;
            font-weight: 600;
        }

        .chart-wrapper {
            position: relative;
            width: 100%;
            min-height: 300px;
        }

        #cuadroTiposComidas {
            height: 500px !important;
        }

        @media (max-width: 768px) {
            .dashboard-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <h1 class="mb-4">Dashboard de Manager</h1>
        
        <div class="dashboard-container">
            <!-- Gráficos de categorías -->
            <div class="chart-card">
                <div class="chart-wrapper">
                    <canvas id="cervezasXestilo"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-wrapper">
                    <canvas id="bebidasAlcoholicas"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-wrapper">
                    <canvas id="cuadroTiposComidas"></canvas>
                </div>
            </div>

            <!-- Gráficos de precios -->
            <div class="chart-card">
                <div class="chart-wrapper">
                    <canvas id="cuadroComidasPrecio"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-wrapper">
                    <canvas id="cuadroBebidasPrecio"></canvas>
                </div>
            </div>

            <!-- Gráficos de proveedores -->
            <div class="chart-card">
                <div class="chart-wrapper">
                    <canvas id="cuadroProveedoresProducto"></canvas>
                </div>
            </div>
            <div class="chart-card">
                <div class="chart-wrapper">
                    <canvas id="cuadroComidaComandas"></canvas>
                </div>
            </div>
            <div class="chart-card">
                <div class="chart-wrapper">
                    <canvas id="cuadroRefrescosComandas"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-wrapper">
                    <canvas id="cuadroBebidasComandas"></canvas>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="{{ asset('js/managerEstadisticas.js') }}"></script>
{% endblock %}