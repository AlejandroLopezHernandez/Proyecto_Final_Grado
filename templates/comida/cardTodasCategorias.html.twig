{% extends 'base.html.twig' %}

{% block title %}Categorías de Comida{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/CardCategoria.css') }}">
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Categorías de Comida</h1>
        <div class="row g-3">
            {% for categoria in categorias %}
                <div class="col-12 col-md-4 col-lg-2-4">
                    <button class="categoria-btn w-100" data-categoria="{{ categoria.name|upper }}">
                        {{ categoria.value|upper }}
                    </button>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}