{% extends 'base.html.twig' %}

{% block title %}Histórico de Comandas{% endblock %}

{% block stylesheets %}
<style>
.ticket {
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 15px;
    margin: 15px auto;
    max-width: 400px;
    background: #f9f9f9;
    box-shadow: 2px 2px 5px rgba(0,0,0,0.1);
    font-family: monospace;
}
.ticket h3 {
    text-align: center;
    font-size: 18px;
    margin-bottom: 10px;
}
.ticket .linea {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed #ccc;
    padding: 3px 0;
}
.ticket .extras {
    font-size: 12px;
    color: #555;
    margin-left: 15px;
}
.ticket .total {
    font-weight: bold;
    text-align: right;
    margin-top: 10px;
}
.btnImprimir {
    background: #28a745;
    color: #fff;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    margin-top: 10px;
}
.btnImprimir:hover {
    background: #218838;
}
</style>
{% endblock %}

{% block body %}
<h1 style="text-align: center;">Histórico de Tickets</h1>

{% for comanda in comandas %}
    <div class="ticket">
        <h3>Ticket #{{ comanda.id }} <br> {{ comanda.fecha ? comanda.fecha|date('d/m/Y H:i') : '' }}</h3>
        
        {% set total = 0 %}
        {% for item in comanda.productos ?? [] %}
            <div class="linea">
                <span>{{ item.nombre }}</span>
                <span>{{ item.cantidad }} x {{ item.precio|number_format(2, '.', '') }}€</span>
            </div>
            {% if item.extras is defined and item.extras|length > 0 %}
                {% for extra in item.extras %}
                    <div class="extras">+ {{ extra }}</div>
                {% endfor %}
            {% endif %}
            {% set total = total + (item.cantidad * item.precio) %}
        {% endfor %}

        <div class="total">TOTAL: {{ total|number_format(2, '.', '') }} €</div>

        <button class="btnImprimir" onclick="generarPDF({{ comanda.id }})">Generar PDF</button>
    </div>
{% else %}
    <p style="text-align: center;">No hay comandas registradas.</p>
{% endfor %}
{% endblock %}

{% block javascripts %}
<script>
function generarPDF(id) {
    fetch('/comanda/imprimir/' + id)
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                window.open(data.url, '_blank');
            } else {
                alert('Error al generar PDF');
            }
        })
        .catch(() => alert('Error al contactar con el servidor'));
}
</script>
{% endblock %}